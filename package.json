{
  "name": "deepclear-ui",
  "version": "1.3.0",
  "private": false,
  "type": "module",
  "description": "DeepClear UI — dot-matrix welcome page and whale-blue accents for the dsh web UI.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "author": "kunnnn",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "appearance",
    "dot-matrix",
    "welcome-page",
    "accent",
    "diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KUN-NNN/deepclear-ui.git"
  },
  "homepage": "https://github.com/KUN-NNN/deepclear-ui#readme",
  "bugs": {
    "url": "https://github.com/KUN-NNN/deepclear-ui/issues"
  }
}
