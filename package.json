{
  "name": "deepclear-ui",
  "version": "1.8.2",
  "private": false,
  "type": "module",
  "description": "DeepClear UI — a quiet dot-matrix theme for reading, coding and working in dsh.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "author": "kunnnn",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "appearance",
    "dot-matrix",
    "welcome-page",
    "accent",
    "diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KUN-NNN/deepclear-ui.git"
  },
  "homepage": "https://github.com/KUN-NNN/deepclear-ui#readme",
  "bugs": {
    "url": "https://github.com/KUN-NNN/deepclear-ui/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check client.js && node --check index.js",
    "build:hero": "node scripts/splice.mjs && node scripts/build.mjs",
    "build": "node scripts/splice.mjs && node scripts/build.mjs && node scripts/build-runtime.mjs"
  }
}
